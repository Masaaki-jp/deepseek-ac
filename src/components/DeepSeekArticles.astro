---
// src/components/DeepSeekArticles.astro
import Parser from 'rss-parser';

const parser = new Parser({
  headers: { 'User-Agent': 'Mozilla/5.0 (DeepSeek Academy RSS Bot)' }
});

const magazines = [
  { name: '『克制』──DeepSeek思想研究', url: 'https://note.com/masa_cloud/m/mfb160546d656' },
  { name: 'DeepSeek攻略マガジン', url: 'https://note.com/masa_cloud/m/m20fedec94474' },
  { name: 'DeepSeek 対話の設計', url: 'https://note.com/masa_cloud/m/m2e13073d42f0' },
  { name: 'DeepSeek API実践マガジン', url: 'https://note.com/masa_cloud/m/m64bf1686bf92' },
  { name: 'DeepSeek 安全運用の手引き', url: 'https://note.com/masa_cloud/m/m7c60ec8a0eb3' },
];

const keywords = [
  'DeepSeek', 'deepseek', '克制', '梁文鋒',
  'セルフホスト', 'データ主権', '越境', '検閲',
  'タイムズカー', '競売', 'AI加工', '法的リスク',
  'API', '安全性', 'アライメント', 'ポテト農家',
];

let articles = [];

try {
  const feed = await parser.parseURL('https://note.com/masa_cloud/rss');

  articles = feed.items
    .filter(item => {
      const text = `${item.title || ''} ${item.contentSnippet || ''}`;
      return keywords.some(kw => text.includes(kw));
    })
    .sort((a, b) => {
      const dateA = new Date(a.pubDate || 0).getTime();
      const dateB = new Date(b.pubDate || 0).getTime();
      return dateB - dateA;
    })
    .slice(0, 5)
    .map(item => ({
      title: item.title || '無題',
      url: item.link || '#',
      date: item.pubDate
        ? new Date(item.pubDate).toLocaleDateString('ja-JP', { month: 'short', day: 'numeric' })
        : '',
      summary: (item.contentSnippet || '').replace(/\n/g, ' ').slice(0, 80) + '…',
    }));
} catch (e) {
  console.error('RSS取得失敗:', e);
}
---

<section class="deepseek-articles">
  <div class="section-head">
    <p class="eyebrow">LATEST FROM NOTE</p>
    <h2>DeepSeek関連の最新記事</h2>
  </div>

  {articles.length > 0 ? (
    <ul class="article-list">
      {articles.map(article => (
        <li>
          <a href={article.url} target="_blank" rel="noopener">
            <div class="article-meta">
              <span class="article-date">{article.date}</span>
            </div>
            <h3 class="article-title">{article.title}</h3>
            <p class="article-summary">{article.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="fallback">記事を取得できませんでした。noteのマガジンを直接ご覧ください。</p>
  )}

  <div class="magazine-links">
    <p class="eyebrow">MAGAZINES</p>
    <div class="magazine-grid">
      {magazines.map(m => (
        <a href={m.url} target="_blank" rel="noopener" class="magazine-link">
          {m.name} →
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .deepseek-articles {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .section-head {
    margin-bottom: 2rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: #888;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .section-head h2 {
    font-size: 1.75rem;
    margin: 0;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .article-list li {
    border-bottom: 1px solid #eee;
  }

  .article-list a {
    display: block;
    padding: 1rem 0;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .article-list a:hover {
    opacity: 0.7;
  }

  .article-meta {
    font-size: 0.8rem;
    color: #888;
    margin-bottom: 0.25rem;
  }

  .article-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .article-summary {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.5;
  }

  .magazine-links {
    margin-top: 3rem;
  }

  .magazine-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .magazine-link {
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .magazine-link:hover {
    background: #f5f5f5;
  }

  .fallback {
    color: #888;
    font-size: 0.9rem;
  }
</style>

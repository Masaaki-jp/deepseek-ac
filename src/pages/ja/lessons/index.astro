---
import Base from '../../../layouts/Base.astro';
import {lessons} from '../../../lib/content.mjs';
const list=lessons();
---
<Base
  title="教材一覧"
  description="DeepSeekの使い方を知り、操作で確かめ、Pythonで実装する。安全な管理まで学べる実践教材の一覧。"
  ogImage="https://deepseek.ac/og/og-lessons.png"
>
  <div class="page-heading">
    <p class="eyebrow">LESSONS</p>
    <h1>教材一覧</h1>
    <p>操作からPythonによる実装、安全な管理へ。</p>
  </div>
  {list.length ? (
    <div class="cards">
      {list.map(l => (
        <article class="card">
          <span>{l.id} · 約{l.minutes}分</span>
          <h2><a href={`/ja/lessons/${l.id}/`}>{l.title}</a></h2>
          <p>{l.summary}</p>
        </article>
      ))}
    </div>
  ) : (
    <p class="empty">教材は準備中です。確認を終えた教材から、ここに掲載します。</p>
  )}
  <p><a href="/ja/start/">学ぶ順番と必要な環境を確認する →</a></p>
</Base>
